    {
      "name": "02 - Idempotency",
      "description": "Validation of strict idempotency contracts for payments and refunds: exact replays return original entities (201 Created), while mutated payloads under identical idempotency keys return 409 Conflict.",
      "item": [
        {
          "name": "01 Replay Payment — Same Idempotency Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created on idempotent replay', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns the same original payment ID', function () {",
                  "    pm.expect(json.id).to.eql(pm.environment.get('paymentId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
