    {
      "name": "04 - Suspended Actors",
      "description": "Validation of suspension semantics: Suspended Merchants are blocked from creating payments (403) while allowed to read history (200); Suspended Processors are blocked from processing lifecycle transitions (403).",
      "item": [
        {
          "name": "01 Suspended Merchant Create Payment — 403 Forbidden",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const key = 'demo-susp-merchant-pay-' + Date.now();",
                  "pm.variables.set('suspendedMerchantPayKey', key);"
                ],
                "type": "text/javascript"
              }
            },
