{
  "info": {
    "_postman_id": "9b1c3d5e-4f7a-4c28-98e1-0d2a4e6f8b32",
    "name": "Payment Gateway API",
    "description": "Comprehensive Postman collection for manual testing, portfolio review, and automated integration validation against the Payment Gateway demo environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Happy Path",
      "description": "Complete payment processing lifecycle: Create Payment -> Verify PENDING -> List Payments -> Approve by Processor -> Request Refund -> Verify Refund PENDING -> List Refunds -> Approve Refund by Processor.",
      "item": [
        {
          "name": "01 Create Payment — Active Merchant",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const key = 'demo-payment-' + Date.now();",
                  "pm.environment.set('paymentIdempotencyKey', key);",
                  "pm.environment.unset('paymentId');",
                  "pm.environment.unset('refundId');",
                  "pm.environment.unset('refundIdempotencyKey');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Payment is initialized in PENDING status', function () {",
                  "    pm.expect(json.status).to.eql('PENDING');",
                  "    pm.expect(json.amount).to.eql(5000);",
                  "    pm.expect(json.currency).to.eql('USD');",
                  "});",
                  "",
                  "pm.test('Store dynamic paymentId in environment', function () {",
                  "    pm.expect(json.id).to.be.a('string');",
                  "    pm.environment.set('paymentId', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{merchantApiKey}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{paymentIdempotencyKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000,\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            }
          },
          "response": []
        },
        {
          "name": "02 Get Payment — Active Merchant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Payment matches ID and is still PENDING', function () {",
                  "    pm.expect(json.id).to.eql(pm.environment.get('paymentId'));",
                  "    pm.expect(json.status).to.eql('PENDING');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{merchantApiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "03 List Payments — Active Merchant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Pagination structure is valid', function () {",
                  "    pm.expect(json.content).to.be.an('array');",
                  "    pm.expect(json.page).to.eql(0);",
                  "    pm.expect(json.size).to.eql(20);",
                  "    pm.expect(json.totalElements).to.be.at.least(1);",
                  "});",
                  "",
                  "pm.test('Created paymentId is present in payment history', function () {",
                  "    const targetId = pm.environment.get('paymentId');",
                  "    const found = json.content.some(item => item.id === targetId);",
                  "    pm.expect(found).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{merchantApiKey}}",
                "type": "text"
              }
            ],
            "url": {
